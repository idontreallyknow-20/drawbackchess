    "test:tournament-pairing": "npx -y tsx scripts/test-tournament-pairing.ts",
    "test:rating-chart": "npx -y tsx scripts/test-rating-chart.ts",
    "test:fx-zones": "npx -y tsx scripts/test-fx-zones.ts",
    "test:usage": "node scripts/check-usage-coverage.cjs",
    "test:treatments": "node scripts/check-treatment-coverage.cjs",
    "test:anim-props": "npx -y tsx scripts/check-anim-props.ts",
